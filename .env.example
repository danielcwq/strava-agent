# Copy to .env and fill in. See SETUP.md for how to obtain each value.

# === Telegram (delivery) ===
# From @BotFather after /newbot
TELEGRAM_BOT_TOKEN=
# Your personal chat_id (numeric). Get via /getUpdates after messaging your bot.
TELEGRAM_CHAT_ID=

# === Anthropic (synthesis) ===
ANTHROPIC_API_KEY=

# === intervals.icu (training load + planned workouts) ===
INTERVALS_ICU_API_KEY=
# Your athlete ID, including the leading "i" — e.g. i12345
INTERVALS_ICU_ATHLETE_ID=

# === Google Sheets (past runs synced from Strava) ===
GOOGLE_SHEET_ID=
# Tab name within the sheet (e.g. Sheet1, Runs)
GOOGLE_SHEET_TAB=Sheet1
# Service account JSON, base64-encoded (single line).
# Generate with: base64 -i path/to/service-account.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# === Google Health API OAuth 2.0 (Fitbit Air data) ===
# OAuth client ID and client secret from Google Auth Platform.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
# Redirect URI registered on the OAuth client. Used by
# scripts/bootstrap_google_health_oauth.py during the one-time authorization flow.
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:8080/google-health/callback

# === Garmin OAuth 2.0 PKCE (from the Developer Portal) ===
# Your app's "Client ID" and "Client Secret".
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
# Redirect URI registered on your Garmin app. Default is the local listener used by
# scripts/bootstrap_garmin_oauth.py during the one-time authorization flow.
GARMIN_REDIRECT_URI=http://localhost:8080/callback
# Random secret embedded in the registered Garmin push URL.
# Generate with: openssl rand -hex 32
GARMIN_WEBHOOK_SECRET=

# Note: access tokens (24h) and refresh tokens (~90d) are NOT stored here.
# They rotate, so they live in SQLite (data/state.db) and are populated by
# scripts/bootstrap_garmin_oauth.py the first time you run it. The app refreshes
# them automatically thereafter.

# === App ===
# Local coaching context is kept out of Git. Copy the tracked example first:
# cp config/training_profile.example.toml config/training_profile.local.toml
TRAINING_PROFILE_PATH=config/training_profile.local.toml
# For container/Fly deployments, base64-encode the local profile and store the
# result as a deployment secret. It takes precedence over TRAINING_PROFILE_PATH.
# These settings seed SQLite once; later bot edits are stored as profile revisions.
TRAINING_PROFILE_TOML_B64=

# Request context allowance, using conservative UTF-8-byte token estimates.
# Stored history is retained independently of this allowance.
CONTEXT_TOKEN_BUDGET=48000
CONTEXT_SUMMARY_TOKENS=3000

# Your local timezone, used for date math and log timestamps.
# Examples: America/Los_Angeles, America/New_York, Europe/London
TIMEZONE=America/Los_Angeles
LOG_LEVEL=INFO
